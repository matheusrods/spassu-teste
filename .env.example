# Copie este arquivo para .env antes de subir o projeto:
#   cp .env.example .env
#
# Depois gere um APP_SECRET (qualquer string aleatória serve para dev):
#   docker compose run --rm app php -r "echo bin2hex(random_bytes(16));"
# e cole o resultado abaixo, em APP_SECRET.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="mysql://symfony:symfony@database:3306/livraria?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> docker compose (serviço database) ###
# Também lido pelo próprio `docker compose` (fora do PHP) para configurar o
# container do MySQL — precisa bater com o usuário/senha/banco do DATABASE_URL acima.
MYSQL_DATABASE=livraria
MYSQL_USER=symfony
MYSQL_PASSWORD=symfony
MYSQL_ROOT_PASSWORD=root
###< docker compose (serviço database) ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
